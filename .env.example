# Скопируйте этот файл в ~/.hermes/.env на сервере, но не коммитьте .env.
# Значения выдаёт и хранит клиент.

TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_ALLOWED_USERS=123456789

# Добавьте только переменные выбранного провайдера модели.
# Названия уточняйте в актуальной официальной документации Hermes.
# OPENROUTER_API_KEY=replace_me
# ANTHROPIC_API_KEY=replace_me
# OPENAI_API_KEY=replace_me

